package SamplePlugin;

{$ALIGN 8}
{$RUNONLY}

(* Runtime package plugin. Consumes the Oasis runtime packages the way a real
  BPL plugin would: requires Oasis.Core (plugin contract + context) and
  Oasis.Bpl (the IOasisPluginFactory contract it registers). The host finds the
  factory via the shared rtl.bpl class list (RegisterClassAlias/FindClass).

  Build with: dcc32 -B -N... -U<Oasis.Core dir> -U<Oasis.Bpl dir> -U<Oasis.Hosting dir> SamplePlugin.dpk
  The .dcp files of Oasis.Core/.Hosting/.Bpl must be on the search path; at run
  time those .bpl files must be on PATH (or next to the host EXE). *)

requires
  rtl,
  Oasis.Core,
  Oasis.Bpl;

contains
  SampleContract,
  SamplePlugin;

end.
