package OasisFramework;

{ Oasis - a Cordis-style plugin framework for Delphi (runtime package). }

{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$IMPLICITBUILD OFF}

requires
  rtl;

contains
  Oasis.Core in 'src\Oasis.Core.pas',
  Oasis.Config in 'src\Oasis.Config.pas',
  Oasis.Plugin in 'src\Oasis.Plugin.pas',
  Oasis.Context in 'src\Oasis.Context.pas';

end.
